<resources>
    <style name="Theme.AtombergRemote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="RemoteKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <color name="bg">#FF101418</color>
    <color name="key">#FF1E252C</color>
    <color name="key_pressed">#FF2F3A45</color>
    <color name="fg">#FFE8ECEF</color>
    <color name="muted">#FF8A96A0</color>
    <color name="accent">#FFE53935</color>
    <color name="boost">#FFFFA000</color>
</resources>
